{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "sketch-shema",
    "title": "Sketch Schema",
    "description": "A schema for defining a sketch",
    "type": "object",
    "properties": {
        "title": {
            "type": "string"
        },
        "useP5": {
            "type": "boolean"
        },
        "created": {
            "type": "string",
            "format": "yyyy-mm-dd"
        },
        "lastUpdated": {
            "type": "string",
            "format": "yyyy-mm-dd"
        },
        "description": {
            "type": "string"
        },
        "skip": {
            "type": "boolean"
        }
    }
}
